{
  "name": "dr-plants-backend",
  "version": "8.3.13",
  "description": "Dr Plants V8C.13 — compatibilidad Hostinger SQLite nativo",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "seed": "node src/db/seed.js",
    "audit": "npm audit --audit-level=high",
    "security:check": "node scripts/security-check.js",
    "check": "node --check app.js && node --check src/server.js && node scripts/security-check.js",
    "postinstall": "npm rebuild better-sqlite3 --build-from-source"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "nodemailer": "9.0.3",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.0.1",
    "hpp": "^0.2.3"
  }
}
